# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase Dashboard -> Project Settings -> API Keys / Data API).
# Leave them empty to run the app in local-only mode.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
