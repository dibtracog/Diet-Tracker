# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase Dashboard -> Project Settings -> API Keys / Data API).
# Leave them empty to run the app in local-only mode.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Reminders (SETUP.md, step 5). Leave empty to run without push notifications.
# Make the key pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any long random text; also goes into supabase/reminders.sql.
CRON_SECRET=
# Supabase -> Project Settings -> API Keys -> Secret key. Server-side only, never commit it.
SUPABASE_SECRET_KEY=
